function renderContent(text) {
  const lines = text.split("\n");
  const out = [];
  let i = 0;

  while (i < lines.length) {
    const line = lines[i];

    // Code block
    if (line.startsWith("```")) {
      const lang = line.slice(3);
      const code = [];
      i++;
      while (i < lines.length && !lines[i].startsWith("```")) { code.push(lines[i]); i++; }
      out.push(
        <pre key={i} style={{ background: "#111", border: "1px solid #222", borderRadius: 6, padding: "14px 18px", overflowX: "auto", margin: "16px 0" }}>
          <code style={{ fontFamily: "'DM Mono', monospace", fontSize: 13, color: "#b0bec5", lineHeight: 1.65 }}>{code.join("\n")}</code>
        </pre>
      );
      i++;
      continue;
    }

    // Table
    if (line.startsWith("|")) {
      const rows = [];
      while (i < lines.length && lines[i].startsWith("|")) {
        if (!lines[i].includes("---")) rows.push(lines[i].split("|").filter(Boolean).map(c => c.trim()));
        i++;
      }
      out.push(
        <table key={i} style={{ width: "100%", borderCollapse: "collapse", margin: "16px 0", fontSize: 14 }}>
          <thead>
            <tr>{rows[0]?.map((c, j) => <th key={j} style={{ textAlign: "left", padding: "8px 12px", borderBottom: "1px solid #222", color: "#888", fontFamily: "'DM Mono', monospace", fontSize: 12, fontWeight: 400 }}>{c}</th>)}</tr>
          </thead>
          <tbody>
            {rows.slice(1).map((r, j) => (
              <tr key={j}>{r.map((c, k) => <td key={k} style={{ padding: "8px 12px", borderBottom: "1px solid #1a1a1a", color: "#ccc", fontSize: 14 }}>{c}</td>)}</tr>
            ))}
          </tbody>
        </table>
      );
      continue;
    }

    // Heading
    if (line.startsWith("**") && line.endsWith("**") && !line.slice(2, -2).includes("**")) {
      out.push(<h3 key={i} style={{ color: "#eee", fontWeight: 600, fontSize: 15, margin: "28px 0 8px", fontFamily: "inherit" }}>{line.slice(2, -2)}</h3>);
      i++; continue;
    }

    // Paragraph with inline bold
    if (line.trim()) {
      const parts = line.split(/(\*\*[^*]+\*\*|`[^`]+`)/g).map((p, j) => {
        if (p.startsWith("**") && p.endsWith("**")) return <strong key={j} style={{ color: "#eee", fontWeight: 600 }}>{p.slice(2, -2)}</strong>;
        if (p.startsWith("`") && p.endsWith("`")) return <code key={j} style={{ background: "#1a1a1a", color: "#e07a5f", padding: "1px 6px", borderRadius: 3, fontSize: 13, fontFamily: "'DM Mono', monospace" }}>{p.slice(1, -1)}</code>;
        return p;
      });
      out.push(<p key={i} style={{ color: "#999", lineHeight: 1.75, margin: "6px 0", fontSize: 15 }}>{parts}</p>);
    } else {
      out.push(<div key={i} style={{ height: 8 }} />);
    }
    i++;
  }
  return out;
}

